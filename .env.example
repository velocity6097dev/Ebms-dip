# Copy this file to .env and fill in your own Supabase project values.
# Find these in Supabase Dashboard -> Project Settings -> API Keys

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public key — safe to expose to the browser (protected by Row Level Security).
# Called "Publishable key" (sb_publishable_...) on newer projects, or
# "anon public" on older ones.
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# SECRET key — server-only, NEVER expose this to the browser or commit it.
# Called "Secret key" (sb_secret_...) on newer projects, or "service_role"
# on older ones. Required for the owner to create/remove staff logins.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-OR-SERVICE-ROLE-KEY

PORT=3000
